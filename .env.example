# Postgres (Supabase): Settings → Database → Connection string
# Use Transaction pooler (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — required for Prisma migrations
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"

# Public URL of the app (production)
AUTH_URL="http://localhost:3000"

# Admin seed (scripts/seed-admin.ts) — senha forte, NÃO use SARAM
ADMIN_SARAM="admin"
ADMIN_PASSWORD="TroqueEstaSenhaForte!"
ADMIN_NOME="Administrador TI"
