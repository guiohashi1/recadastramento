# Postgres (Supabase)
# DATABASE_URL = Transaction pooler (porta 6543) — runtime / Render
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = conexão direta (porta 5432) — migrations no build
# Preferir host db.<ref>.supabase.co se o pooler Session falhar no migrate
DIRECT_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"

# Public URL of the app
# Local: http://localhost:3000
# Render: https://SEU-SERVICO.onrender.com
# Vercel: https://SEU-PROJETO.vercel.app
AUTH_URL="http://localhost:3000"

# Admin seed (rodar uma vez: npm run seed:admin)
ADMIN_SARAM="admin"
ADMIN_PASSWORD="SenhaForte"
ADMIN_NOME="Administrador TI"
